{
  "name": "edu-python",
  "version": "0.1.0",
  "description": "Онлайн-редактор Python для школи: MicroPython у браузері, input(), turtle і вікна tkinter, пояснення помилок українською",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zavada123/edu-python.git"
  },
  "files": [
    "lib"
  ],
  "sideEffects": [
    "**/*.css",
    "./lib/react.js",
    "./lib/worker.js"
  ],
  "exports": {
    "./engine": {
      "types": "./lib/types/engine.d.ts",
      "import": "./lib/engine.js"
    },
    "./core": {
      "types": "./lib/types/core.d.ts",
      "import": "./lib/core.js"
    },
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "import": "./lib/worker.js"
    },
    "./react": {
      "types": "./lib/types/react.d.ts",
      "import": "./lib/react.js"
    },
    "./style.css": "./lib/style.css"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.6",
    "@lezer/highlight": "1.2.5",
    "@lezer/python": "1.1.19",
    "@micropython/micropython-webassembly-pyscript": "1.29.0-6",
    "lucide-react": "1.77.0"
  },
  "peerDependencies": {
    "effect": "4.1.5",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "effect": "4.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
