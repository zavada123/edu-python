{
  "name": "edu-python",
  "version": "0.1.0",
  "description": "Онлайн-редактор Python для школи: MicroPython у браузері, input(), turtle і вікна tkinter, пояснення помилок українською",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zavada123/edu-python.git"
  },
  "files": [
    "lib"
  ],
  "sideEffects": [
    "**/*.css",
    "./lib/react.js",
    "./lib/worker.js"
  ],
  "exports": {
    "./engine": {
      "types": "./lib/types/engine.d.ts",
      "import": "./lib/engine.js"
    },
    "./core": {
      "types": "./lib/types/core.d.ts",
      "import": "./lib/core.js"
    },
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "import": "./lib/worker.js"
    },
    "./react": {
      "types": "./lib/types/react.d.ts",
      "import": "./lib/react.js"
    },
    "./style.css": "./lib/style.css"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@micropython/micropython-webassembly-pyscript": "1.29.0-6",
    "lucide-react": "1.48.0"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.117",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "effect": "4.0.0-rc.117",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
